# Pre-production (https://vigie.pp.theosementa.fr, host port 8102).
# The deploy workflow copies this file to .env on the first deploy of the `preprod` branch and
# fills SECRET_KEY and POSTGRES_PASSWORD. Edit that .env on the server afterwards (to let more
# people in, add their address to ALLOWED_EMAILS, then `docker compose up -d`).
# Never commit a real .env.

# Own compose project: containers and volumes (database!) never touch production's.
COMPOSE_PROJECT_NAME=vigie-pp

SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_USER=vigie
POSTGRES_DB=vigie

# Plain HTTP behind the tunnel / reverse proxy, on 8102 (production is 8101).
VIGIE_DOMAIN=:80
VIGIE_HTTP_PORT=8102
VIGIE_HTTPS_PORT=8452
VIGIE_TRUSTED_PROXIES=private_ranges

JWT_EXPIRE_DAYS=30
COOKIE_SECURE=auto
REGISTRATION=invite
# Only these addresses can sign up, sign in or be invited. Comma-separated.
ALLOWED_EMAILS=theosementa@gmail.com
PUBLIC_URL=https://vigie.pp.theosementa.fr
