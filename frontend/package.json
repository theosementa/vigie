{
  "name": "vigie-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "cd ../backend && uv run python -m app.openapi_export > ../frontend/src/api/openapi.json && cd ../frontend && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "icons": "node scripts/icons.mjs",
    "brands": "node scripts/brands.mjs",
    "generate-pwa-assets": "pwa-assets-generator --config pwa-assets.config.ts"
  },
  "dependencies": {
