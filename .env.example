# Copy to .env and adjust: `cp .env.example .env`
# docker compose reads this file automatically. Never commit your .env.

# --- Required secrets (compose refuses to start without them) ---
# Signs session tokens. At least 32 characters; the API refuses to start otherwise.
# Generate one with: openssl rand -hex 32
SECRET_KEY=
# Password of the PostgreSQL user. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- PostgreSQL ---
POSTGRES_USER=vigie
POSTGRES_DB=vigie

# --- Web (Caddy) ---
# Site address. ":80" = plain HTTP, for a LAN or behind your own reverse proxy.
# A real domain (e.g. vigie.example.com) enables Caddy's automatic HTTPS.
VIGIE_DOMAIN=:80
# Host ports. Defaults avoid needing root. For automatic HTTPS set 80 and 443.
VIGIE_HTTP_PORT=8080
VIGIE_HTTPS_PORT=8443
# Proxies whose X-Forwarded-For is trusted, so rate limiting sees the real client IP.
# Leave empty if clients reach Vigie directly. Behind a tunnel or another proxy on
# a private network, use: private_ranges
VIGIE_TRUSTED_PROXIES=

# --- API ---
# Session lifetime in days.
JWT_EXPIRE_DAYS=30
# auto = Secure cookie when the request is HTTPS (recommended); true / false to force.
COOKIE_SECURE=auto
# Initial registration mode of a NEW instance: invite | open | closed.
# After the first start the admin changes it in the app; this value is then ignored.
REGISTRATION=invite
# Public base URL of the instance (used in password-reset links). Optional.
PUBLIC_URL=
# Metadata fetching limits.
FETCH_TIMEOUT_SECONDS=5
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=3
