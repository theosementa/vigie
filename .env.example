# Copy to .env and adjust. docker compose reads this file automatically.

# --- PostgreSQL ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar

# --- API (inside docker compose, DATABASE_URL is derived from the POSTGRES_* values) ---
# For running the API on the host (uv run uvicorn ...), point to the published db port:
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
# Used by `uv run pytest` (database is created automatically if missing):
TEST_DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar_test

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
